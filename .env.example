# Throw API 环境变量样例（复制为 .env 使用；.env 不入 Git）

# development | production | test
APP_ENV=development

# 监听地址与端口（开发默认 127.0.0.1:3000）
HOST=127.0.0.1
PORT=3000

# 对外访问 origin 列表（逗号分隔）。
# production 必填：用于 CORS 与 WebSocket Origin 校验，缺失时服务拒绝启动（fail fast）
# PUBLIC_ORIGIN=https://throw.example.com

# 中转文件临时目录（默认取系统 tmp：/tmp/throw-relay）
# TMP_DIR=

# 日志级别：trace|debug|info|warn|error
LOG_LEVEL=info
